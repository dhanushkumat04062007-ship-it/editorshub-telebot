# Copy to editorshub_aura/.env for local runs. Never commit the real file.

# Telegram
BOT_TOKEN=123456:your-bot-token-from-BotFather
SUPER_ADMIN_ID=your_telegram_user_id
ADMIN_ID=
JOBS_CHANNEL_ID=-100xxxxxxxxxx
EDITORS_COMMUNITY_ID=-100xxxxxxxxxx

# Google Sheets (service account)
GOOGLE_SHEET_KEY=your_spreadsheet_id
# Either paste the service-account JSON on one line...
GOOGLE_CREDENTIALS=
# ...or point to the key file
GOOGLE_CREDENTIALS_FILE=credentials.json

# AI moderation (optional; messages pass through if unset or the API is down)
OPENAI_API_KEY=

# Health-check port
PORT=8080
